+class QQMediaTransferFailed(RuntimeError):
+    """QQ or its adapter explicitly failed to prepare or upload an image."""
+
+
+def _qq_media_upload_rejected(batch: DeliveryBatch) -> bool:
+    if batch.route_key.platform != "qq" or len(batch.receipts) != 1:
+        return False
+    receipt = batch.receipts[0]
+    if (
+        receipt.status != DeliveryStatus.FAILED
+        or receipt.driver_id != "gateway:maibot-team.snowluma-adapter:snowluma_gateway"
+    ):
+        return False
+    error = receipt.error or ""
+    # NapCat reads and writes the temporary media before submitting the message.
+    action, _, detail = error.partition(" message=")
+    if action in {"对端动作返回失败: action=send_group_msg", "对端动作返回失败: action=send_private_msg"} and detail in (
+        "ENOMEM: not enough memory, read",
+        "ENOMEM: not enough memory, write",
+    ):
+        return True
+    heading, separator, payload = error.partition("EventRet:")
+    if not separator or "EventChecker Failed: NTEvent serviceAndMethod:NodeIKernelMsgService/sendMsg " not in heading:
+        return False
+    try:
+        response = json.loads(payload)
+    except ValueError:
+        return False
+    return (
+        isinstance(response, dict)
+        and response.get("result") == -1
+        and response.get("errMsg") == "rich media transfer failed"
+    )
+
